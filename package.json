{
  "name": "video-ai-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "sample": "python3 scripts/make-sample.py public/sample && python3 scripts/make-fg.py public/sample/take.mp4 public/sample/masks public/sample/fg && python3 scripts/make-sticker-mattes.py public/sample/fg public/sample/sticker",
    "typecheck": "tsc --noEmit",
    "render:showcase": "remotion render FxShowcase out/showcase.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:edit": "remotion render ExampleEdit out/edit.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k",
    "stills": "node scripts/fx-stills.mjs",
    "bench": "node scripts/fx-bench.mjs",
    "render:repo-showcase": "remotion render RepoShowcase out/repo-showcase.mp4 --codec=h264 --crf=21 --pixel-format=yuv420p",
    "hyperframes:lint": "node scripts/prepare-hyperframes.mjs && cd hyperframes/projects/kinetic-intro && ../../../node_modules/.bin/hyperframes lint",
    "hyperframes:render": "node scripts/render-hyperframes.mjs",
    "hyperframes:studio": "cd hyperframes/projects/kinetic-intro && ../../../node_modules/.bin/hyperframes preview",
    "advanced-fx:sample": "npm run sample && python3 scripts/generate_advanced_fx_audio.py",
    "advanced-fx:showcase": "remotion render AdvancedFxShowcase out/advanced-fx.mp4 --codec=h264 --pixel-format=yuv420p --crf=19 --concurrency=2",
    "showreel:voices": "python3 scripts/render_showreel_voices.py",
    "showreel:prepare": "python3 scripts/prepare_showreel.py",
    "showreel:check": "python3 scripts/prepare_showreel.py --check",
    "render:cinematic-showreel": "node scripts/render_cinematic_showreel.mjs",
    "render:host-word-poses": "node scripts/render_host_word_poses.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.522",
    "@remotion/captions": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/effects": "4.0.522",
    "@remotion/fonts": "4.0.522",
    "@remotion/lottie": "4.0.522",
    "@remotion/media": "4.0.522",
    "@remotion/motion-blur": "4.0.522",
    "@remotion/player": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "@remotion/sfx": "4.0.522",
    "@remotion/shapes": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "lottie-web": "5.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.522",
    "@remotion/paths": "4.0.522"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "hyperframes": "0.8.222",
    "gsap": "3.14.2"
  }
}
